{
  "repo": "plume-move-opening-lab",
  "language": "Elixir",
  "category": "Chess and game engines",
  "goal": "Build an Elixir toolkit that studies opening behavior through node-edge fixtures, with cycle and reachability reports and synthetic fixtures only.",
  "review_model": {
    "terms": [
      "position pressure",
      "move ordering",
      "search width",
      "endgame risk"
